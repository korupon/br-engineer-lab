pipeline {
    agent any  // <-- instead of docker

    environment {
        APP_NAME = "banking-app"
        BRANCH = "Banking-App-CI-CD"
        DEPLOY_ENV = "SIT"  // or UAT / PROD
        GIT_CREDENTIALS = "github-token"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "Building ${APP_NAME}..."
                sh 'mvn clean package -DskipTests' // make sure Maven is installed on Jenkins agent
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying to ${DEPLOY_ENV}..."
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Build & deployment succeeded!"
        }
        failure {
            echo "Build failed!"
        }
    }
}
